---
import '../styles/global.css';
const TEST_NUMBER = '2348000000000'; // Replace with Splash Car Wash's WhatsApp number before launch.
const services = [
  { name: 'Exterior wash', time: 'About 30 minutes', sedan: 3000, suv: 4000, image: '/images/exterior.webp', alt: 'Freshly washed car exterior' },
  { name: 'Interior + exterior', time: 'About 1 hour', sedan: 5000, suv: 7000, image: '/images/interior.webp', alt: 'Clean car interior' },
  { name: 'Engine wash add-on', time: 'About 1 hour', sedan: 3000, suv: 4000 },
  { name: 'Office / home service', time: 'Staff confirm time', sedan: 9000, suv: 12000, from: true },
  { name: 'Full auto detailing', time: 'Staff confirm', sedan: 20000, suv: 30000, from: true },
];
const memberships = [
  { name: 'Basic', sedan: 10000, suv: 13000, detail: '4 exterior washes' },
  { name: 'Standard', sedan: 17000, suv: 24000, detail: '4 interior + exterior washes' },
  { name: 'Premium', sedan: 21000, suv: 30000, detail: '4 interior + exterior washes + 1 engine wash' },
];
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#0A1F33" /><meta name="description" content="Car washing in Okhoro, Benin City. Open Monday to Saturday, 7am–8pm. Request a wash by WhatsApp." /><title>Splash Car Wash | Okhoro, Benin City</title></head>
  <body>
    <header class="hero">
      <img class="hero-img" src="/images/hero.webp" alt="AI-generated photo of a Splash Car Wash attendant washing a car" fetchpriority="high" />
      <nav><a class="brand" href="#top">SPLASH<span>CAR WASH</span></a><a href="#location">Find us</a></nav>
      <div class="hero-copy" id="top"><span class="eyebrow">OKHORO · BENIN CITY</span><h1>Open 7am to 8pm, Monday to Saturday. Skip the Saturday queue.</h1><div class="status" id="open-status">Checking today’s hours…</div><div class="hero-actions"><a class="button" href="#book">Book a Wash <span aria-hidden="true">↗</span></a><span class="micro">Staff confirm your slot, especially on Saturdays.</span></div></div>
      <span class="ai-note">AI-generated</span>
    </header>
    <main>
      <section class="light section timing"><div class="section-head"><span class="eyebrow">PLAN YOUR VISIT</span><h2>Best time to come</h2><p>Weekday mornings are usually quieter. Choose a calmer day and get on with yours.</p></div><div class="chart" aria-label="Typical weekly customer levels"><div class="bar-wrap"><span class="bar" style="--h:28%"></span><b>Mon</b><small>Quiet</small></div><div class="bar-wrap"><span class="bar" style="--h:35%"></span><b>Tue</b></div><div class="bar-wrap"><span class="bar" style="--h:38%"></span><b>Wed</b></div><div class="bar-wrap"><span class="bar" style="--h:43%"></span><b>Thu</b></div><div class="bar-wrap"><span class="bar" style="--h:52%"></span><b>Fri</b></div><div class="bar-wrap"><span class="bar sat" style="--h:94%"></span><b>Sat</b><small>Busiest</small></div><div class="bar-wrap closed"><span class="bar" style="--h:5%"></span><b>Sun</b><small>Closed</small></div></div><p class="footnote">Typical, not live. We recommend requesting your preferred time.</p></section>
      <section class="dark section" id="services"><div class="section-head"><span class="eyebrow">THE RIGHT CLEAN</span><h2>Services &amp; prices</h2><p>Choose your vehicle size. Prices are in Nigerian naira.</p></div>
        <div class="service-list">{services.map((s) => <article class="service-row"><div class="service-info">{s.image && <img src={s.image} alt={`${s.alt} — AI-generated`} loading="lazy" />}<div><h3>{s.name}</h3><p>{s.time}</p></div></div><div class="prices"><span>{s.from && <small>from </small>}₦{s.sedan.toLocaleString()} <i>|</i> ₦{s.suv.toLocaleString()}</span><small>Sedan / small car <i>|</i> SUV / truck</small></div></article>)}</div>
        <div class="calculator"><div><span class="eyebrow">QUICK ESTIMATE</span><h3>Plan your wash</h3></div><label>Service<select id="calc-service">{services.map((s,i)=><option value={i}>{s.name}</option>)}</select></label><label>Vehicle<select id="calc-car"><option value="sedan">Sedan / small car</option><option value="suv">SUV / truck</option></select></label><p class="estimate" id="estimate">₦3,000</p><small class="micro">Staff confirm the final price and visit time.</small></div>
      </section>
      <section class="light section office"><div class="split"><img src="/images/office.webp" alt="Car wash at your office or home — AI-generated" loading="lazy" /><div><span class="eyebrow">WE COME TO YOU</span><h2>Office and home wash</h2><p>Keep your day moving. Tell us where you are and staff will confirm availability and the visit time.</p><a class="button" id="location-share" href="#book">Share my location</a><p class="footnote">From ₦9,000 sedan / small car · ₦12,000 SUV / truck</p></div></div></section>
      <section class="light section membership"><div class="section-head"><span class="eyebrow">A BETTER WEEKDAY ROUTINE</span><h2>Membership</h2><p>Weekdays only · One car per membership · One wash per day</p></div><div class="member-list">{memberships.map(m=><article><div><h3>{m.name}</h3><p>{m.detail}</p></div><div class="member-price">₦{m.sedan.toLocaleString()} <i>|</i> ₦{m.suv.toLocaleString()}<small>Sedan / small car <i>|</i> SUV / truck</small></div><a class="button button-dark join" href="#book" data-membership={m.name}>Join</a></article>)}</div><p class="footnote">Unused washes expire at month end. Staff confirm every visit.</p></section>
      <section class="dark section compare"><div class="section-head"><span class="eyebrow">A FRESH START</span><h2>See the difference</h2></div><div class="comparison"><img src="/images/before.webp" alt="Before wash — AI-generated" loading="lazy" /><img src="/images/after.webp" alt="After wash — AI-generated" loading="lazy" /><span>BEFORE</span><span>AFTER</span></div></section>
      <section class="light section gallery"><div class="section-head"><span class="eyebrow">A LOOK AROUND</span><h2>The Splash experience</h2></div><div class="gallery-grid">{['hero','exterior','interior','office','before','after'].map((img)=><img src={`/images/${img}.webp`} alt={`Splash Car Wash ${img} — AI-generated`} loading="lazy" />)}</div></section>
      <section class="dark section booking" id="book"><span class="eyebrow">MAKE A REQUEST</span><h2>Your preferred time, our personal confirmation.</h2><form id="booking-form"><label>Service<select id="service-select">{services.map(s=><option>{s.name}</option>)}</select></label><label>Car type<select id="car-select"><option>Sedan / small car</option><option>SUV / truck</option></select></label><label>Preferred day<input id="day" required placeholder="e.g. Tuesday" /></label><label>Preferred time<input id="time" required placeholder="e.g. 7:15am" /></label><label>Your name<input id="name" required placeholder="Name" /></label><button class="button" type="submit">Book a Wash <span aria-hidden="true">↗</span></button><p class="micro">Staff confirm your slot, especially on Saturdays. Your request is not a confirmed booking.</p></form><div class="chatbase-placeholder" aria-label="Chatbase embed placeholder">Chatbase assistant placeholder</div></section>
      <section class="light section location" id="location"><div class="section-head"><span class="eyebrow">COME BY</span><h2>Find Splash</h2><p>Okhoro, Benin City, Nigeria</p></div><iframe title="Map of Okhoro, Benin City" src="https://maps.google.com/maps?q=Okhoro%2C%20Benin%20City%2C%20Nigeria&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><a class="button button-dark" href="https://www.google.com/maps/search/?api=1&query=Okhoro%2C+Benin+City%2C+Nigeria" target="_blank" rel="noopener">Get directions ↗</a><div class="info-grid"><div><h3>Opening hours</h3><p>Monday–Saturday<br />7:00am–8:00pm<br />Sunday: Closed</p></div><div><h3>How to pay</h3><p>Cash · Transfer · POS</p></div><div><h3>Need a person?</h3><p>For damage concerns, please speak directly with our staff.</p></div></div></section>
    </main><footer><a class="brand" href="#top">SPLASH<span>CAR WASH</span></a><p>Okhoro, Benin City · Open Mon–Sat, 7am–8pm</p><a href="#top">Back to top ↑</a></footer>
    <script define:vars={{ TEST_NUMBER, services, memberships }}>
      const status = document.querySelector('#open-status');
      const now = new Date();
      const local = new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Lagos',weekday:'short',hour:'numeric',minute:'numeric',hour12:false}).formatToParts(now);
      const part = k => local.find(x=>x.type===k)?.value;
      const day = part('weekday'), hour = Number(part('hour'));
      status.textContent = day !== 'Sun' && hour >= 7 && hour < 20 ? '● Open now · Closes at 8pm' : '○ Closed now · Opens 7am, Monday';
      const calc = () => {const s=services[Number(document.querySelector('#calc-service').value)]; const price=s[document.querySelector('#calc-car').value]; document.querySelector('#estimate').textContent=`${s.from?'From ':''}₦${price.toLocaleString()}`;};
      document.querySelector('#calc-service').addEventListener('change',calc); document.querySelector('#calc-car').addEventListener('change',calc);
      const wa = msg => `https://wa.me/${TEST_NUMBER}?text=${encodeURIComponent(msg)}`;
      document.querySelector('#booking-form').addEventListener('submit',e=>{e.preventDefault(); const vals=['#service-select','#car-select','#day','#time','#name'].map(sel=>document.querySelector(sel).value); location.href=wa(`Wash request\nService: ${vals[0]}\nCar type: ${vals[1]}\nPreferred day: ${vals[2]}\nPreferred time: ${vals[3]}\nName: ${vals[4]}\nPlease confirm availability and final price.`);});
      document.querySelectorAll('.join').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const form=document.querySelector('#booking-form'); form.querySelector('#service-select').value=`${a.dataset.membership} membership`; location.href=wa(`${a.dataset.membership} membership request\nCar type: sedan / small car or SUV / truck\nPreferred day and time: please reply with your preference\nName: please reply with your name\nStaff confirm every visit and final price.`);}));
      document.querySelector('#location-share').addEventListener('click',e=>{e.preventDefault();const send=coords=>{const map=coords?`https://maps.google.com/?q=${coords.latitude},${coords.longitude}`:'Please share your location in WhatsApp';location.href=wa(`Office / home wash request\nService: Office / home service\nCar type: sedan / small car or SUV / truck\nPreferred day and time: please reply with your preference\nName: please reply with your name\nLocation: ${map}\nStaff confirm time and final price.`);}; if(navigator.geolocation) navigator.geolocation.getCurrentPosition(p=>send(p.coords),()=>send(null),{timeout:8000});else send(null);});
    </script>
  </body>
</html>
